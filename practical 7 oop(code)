#include <iostream>
#include <cstring>
using namespace std;

class String
{
    char str[100];

public:
    // Default constructor
    String()
    {
        strcpy(str, "");
    }

    // Parameterized constructor
    String(const char s[])
    {
        strcpy(str, s);
    }

    // Copy constructor
    String(const String &s)
    {
        strcpy(str, s.str);
    }

    // Accept function
    void Accept()
    {
        cout << "Enter a string: ";
        cin.getline(str, 100);
    }

    // Display function
    void Display()
    {
        cout << "String: " << str << endl;
    }

    // Destructor
    ~String()
    {
        cout << "Destructor called." << endl;
    }
};

int main()
{
    String s1;          // Default constructor
    s1.Accept();
    s1.Display();

    String s2("Hello"); // Parameterized constructor
    s2.Display();

    String s3(s2);      // Copy constructor
    s3.Display();

    return 0;
}
